rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }

    // Nhóm: người đầu tiên tạo nhóm là chủ nhóm; chỉ chủ nhóm sửa danh sách thành viên.
    match /teams/{team} {
      allow read: if signedIn() && (resource == null || me() in resource.data.members);
      allow create: if signedIn() && request.resource.data.owner == me() && request.resource.data.members == [me()];
      allow update: if signedIn() && resource.data.owner == me() && request.resource.data.owner == resource.data.owner;
    }

    // Dữ liệu dùng chung của nhóm: chỉ thành viên mới đọc/ghi được.
    match /data/users/{team}/{document=**} {
      allow read, write: if signedIn() && me() in get(/databases/$(database)/documents/teams/$(team)).data.members;
    }

    // ===== Bản v2 =====
    function orgDoc(org) { return get(/databases/$(database)/documents/orgs/$(org)).data; }
    function roleIn(org) {
      let d = orgDoc(org);
      return d.admin == me() ? 'admin' : d.roles.get(me(), null);
    }
    function isMember(org) { return signedIn() && roleIn(org) != null; }
    function canEdit(org) { return signedIn() && roleIn(org) in ['admin', 'editor']; }

    match /orgs/{org} {
      allow get: if signedIn() && (resource == null || resource.data.admin == me() || me() in resource.data.roles);
      // Người đầu tiên đăng nhập vào nhóm trống thành admin.
      // Only the studio's org, and only while it doesn't exist yet.
      allow create: if org == 'mthanglee' && signedIn() && request.resource.data.admin == me() && request.resource.data.roles == {};
      allow update: if signedIn() && resource.data.admin == me()
        && request.resource.data.admin == resource.data.admin
        && request.resource.data.roles is map && request.resource.data.roles.size() <= 19;

      match /{coll}/{id} {
        allow read: if coll in ['weddings', 'tasks', 'unmatched', 'freelancers'] && isMember(org);
        allow write: if coll in ['weddings', 'tasks', 'unmatched', 'freelancers'] && canEdit(org);
      }

      // Chấm công: tiền công người edit, chỉ chủ nhóm đọc/ghi.
      function isAdmin() { return signedIn() && orgDoc(org).admin == me(); }
      function payrollOk(d) {
        return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.personId is string && d.personId.size() > 0 && d.personId.size() <= 200
          && d.person is string && d.person.size() <= 200 && d.item is string && d.item.size() > 0 && d.item.size() <= 200
          && d.price is int && d.price >= 0 && d.price <= 100000000
          && (!('weddingId' in d) || (d.weddingId is string && d.weddingId.size() <= 200))
          && (!('weddingName' in d) || (d.weddingName is string && d.weddingName.size() <= 200))
          && (!('note' in d) || (d.note is string && d.note.size() <= 1000));
      }
      match /payroll/{id} {
        allow read, delete: if isAdmin();
        allow create, update: if isAdmin() && payrollOk(request.resource.data);
      }
      match /payrollConfig/{id} {
        allow read, write: if isAdmin();
      }
    }

    // Phiếu khách: ai có link (mã khó đoán) đều mở được; chỉ được gửi câu trả lời.
    function answersOk(a) {
      return a is map && a.size() <= 40
        && a.keys().hasOnly(['kind', 'bride', 'groom', 'phoneBride', 'phoneGroom', 'date', 'addrBride', 'tMakeup',
             'addrGroom', 'tDepart', 'tArrive', 'tRuoc', 'addrRest', 'tWelcome', 'tParty', 'note'])
        && answerLen(a);
    }
    function answerLen(a) {
      // Mỗi câu trả lời là chữ, tối đa 1000 ký tự (kiểm tra từng khoá đã biết).
      return (!('bride' in a) || (a.bride is string && a.bride.size() <= 1000)) && (!('groom' in a) || (a.groom is string && a.groom.size() <= 1000))
        && (!('phoneBride' in a) || (a.phoneBride is string && a.phoneBride.size() <= 1000)) && (!('phoneGroom' in a) || (a.phoneGroom is string && a.phoneGroom.size() <= 1000))
        && (!('date' in a) || (a.date is string && a.date.size() <= 1000)) && (!('kind' in a) || (a.kind is string && a.kind.size() <= 1000))
        && (!('addrBride' in a) || (a.addrBride is string && a.addrBride.size() <= 1000)) && (!('addrGroom' in a) || (a.addrGroom is string && a.addrGroom.size() <= 1000))
        && (!('addrRest' in a) || (a.addrRest is string && a.addrRest.size() <= 1000)) && (!('note' in a) || (a.note is string && a.note.size() <= 1000))
        && (!('tMakeup' in a) || (a.tMakeup is string && a.tMakeup.size() <= 1000)) && (!('tDepart' in a) || (a.tDepart is string && a.tDepart.size() <= 1000))
        && (!('tArrive' in a) || (a.tArrive is string && a.tArrive.size() <= 1000)) && (!('tRuoc' in a) || (a.tRuoc is string && a.tRuoc.size() <= 1000))
        && (!('tWelcome' in a) || (a.tWelcome is string && a.tWelcome.size() <= 1000)) && (!('tParty' in a) || (a.tParty is string && a.tParty.size() <= 1000));
    }
    match /invites/{token} {
      allow get: if true;
      allow list: if canEdit(resource.data.org);
      allow create: if canEdit(request.resource.data.org) && request.resource.data.status == 'open';
      allow update: if (canEdit(resource.data.org) && request.resource.data.org == resource.data.org
            // Đưa vào hồ sơ phải đúng lần gửi đang xem (khách có thể vừa sửa phiếu).
            && !(resource.data.status == 'submitted' && request.resource.data.status == 'applied'
                 && request.resource.data.get('appliedSubmittedAt', null) != resource.data.submittedAt))
        || (resource.data.status in ['open', 'submitted', 'applied']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'status', 'submittedAt', 'seen', 'base'])
            // base = phần điền sẵn khách đã thấy; kiểm tra y như câu trả lời.
            && (!('base' in request.resource.data) || answersOk(request.resource.data.base))
            && request.resource.data.status == 'submitted' && request.resource.data.seen == false
            && request.resource.data.submittedAt == request.time
            && answersOk(request.resource.data.answers));
      allow delete: if canEdit(resource.data.org);
    }
  }
}
